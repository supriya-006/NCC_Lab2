@model WebApp2BySupriya.Models.Student

@{
    ViewData["Title"] = "Create Student Record";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-gradient text-white p-4 rounded-top-4" style="background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);">
                    <div class="d-flex align-items-center justify-content-between">
                        <div>
                            <h2 class="h4 fw-bold mb-1">Create Student Record</h2>
                            <p class="small mb-0 text-white-50">Fill in student details for server-side validation</p>
                        </div>
                        <div class="bg-white bg-opacity-20 p-3 rounded-circle text-white">
                            <i class="bi bi-person-plus-fill fs-3"></i>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">
                    <form asp-action="Create" asp-controller="Student" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <!-- Global Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 mb-4" role="alert"></div>

                        <!-- Student ID -->
                        <div class="mb-4">
                            <label asp-for="StdID" class="form-label fw-semibold text-dark"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-hash text-primary"></i></span>
                                <input asp-for="StdID" class="form-control form-control-lg" placeholder="e.g. 101" />
                            </div>
                            <span asp-validation-for="StdID" class="validation-error-red"></span>
                        </div>

                        <!-- Full Name -->
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-semibold text-dark"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-person text-primary"></i></span>
                                <input asp-for="Name" class="form-control form-control-lg" placeholder="e.g. Supriya Devkota" />
                            </div>
                            <span asp-validation-for="Name" class="validation-error-red"></span>
                        </div>

                        <!-- Address -->
                        <div class="mb-4">
                            <label asp-for="Address" class="form-label fw-semibold text-dark"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-geo-alt text-primary"></i></span>
                                <input asp-for="Address" class="form-control form-control-lg" placeholder="e.g. Kathmandu, Nepal" />
                            </div>
                            <span asp-validation-for="Address" class="validation-error-red"></span>
                        </div>

                        <!-- Faculty -->
                        <div class="mb-4">
                            <label asp-for="Faculty" class="form-label fw-semibold text-dark"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-book text-primary"></i></span>
                                <input asp-for="Faculty" class="form-control form-control-lg" placeholder="e.g. BSc CSIT" />
                            </div>
                            <span asp-validation-for="Faculty" class="validation-error-red"></span>
                        </div>

                        <!-- Email Address -->
                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-semibold text-dark"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-envelope text-primary"></i></span>
                                <input asp-for="Email" class="form-control form-control-lg" placeholder="e.g. supriya@example.com" />
                            </div>
                            <span asp-validation-for="Email" class="validation-error-red"></span>
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4 pt-2">
                            <a asp-action="MyRazorPage" class="btn btn-light btn-lg px-4 fw-semibold text-secondary me-md-2">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg px-5 fw-bold shadow-sm">
                                <i class="bi bi-check-circle me-1"></i> Submit Record
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Styling server-side validation error messages explicitly in red text */
    .validation-error-red,
    .field-validation-error,
    .text-danger {
        color: #dc3545 !important;
        font-weight: 600;
        font-size: 0.875rem;
        margin-top: 0.375rem;
        display: block;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
