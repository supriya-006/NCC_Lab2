@model WebApp6BySupriya.Models.Student
@{
    ViewData["Title"] = "Edit Student";
}
<h1>Edit Student</h1>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label class="form-label">Name</label><input asp-for="Name" class="form-control"/></div>
    <div class="mb-3"><label class="form-label">Email</label><input asp-for="Email" class="form-control"/></div>
    <div class="mb-3"><label class="form-label">Faculty</label><input asp-for="Faculty" class="form-control"/></div>
    <div class="mb-3"><label class="form-label">GPA</label><input asp-for="Gpa" class="form-control"/></div>
    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-secondary" href="/Students">Cancel</a>
</form>
